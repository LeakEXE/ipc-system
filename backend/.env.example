# Salin file ini menjadi .env lalu isi nilainya:
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux/Mac)

# ---------- Database (PostgreSQL) ----------
# Option A: single connection string (takes precedence when set)
#DATABASE_URL=postgres://postgres:postgres@localhost:5432/ipc_school

# Option B: individual variables
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_NAME=ipc_school

# ---------- Server ----------
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
SUPERADMIN_SETUP_PASSWORD=ganti_dengan_password_awal_rahasia
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000
# Set TRUST_PROXY=1 in production ONLY if behind a reverse proxy (nginx, etc.),
# otherwise clients could spoof IPs to bypass rate limiting.
#TRUST_PROXY=1

# ---------- Login pertama (PENTING) ----------
# Database baru berisi akun ADMIN001 dengan password placeholder.
# Login pertama dengan username ADMIN001 dan password = nilai
# SUPERADMIN_SETUP_PASSWORD di atas. Password otomatis di-hash saat login.
# Segera ganti password lewat menu Profile, lalu hapus variabel itu dari .env.
